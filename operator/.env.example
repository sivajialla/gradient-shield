# RPC endpoint — http://127.0.0.1:8545 for the local anvil demo
RPC_URL=http://127.0.0.1:8545

# Aggregator key. Locally this is anvil account 0, which is also the deployer,
# the task generator, and the account that runs the demo swaps.
AGGREGATOR_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Addresses printed by `make deploy-local`
TASK_MANAGER_ADDRESS=0x...
SCORING_ORACLE_ADDRESS=0x...
HOOK_ADDRESS=0x...
SWAP_ROUTER=0x...
TOKEN0=0x...
TOKEN1=0x...

# Operator BLS keys live in operator/keys.json (generate: node blsKeygen.js).
# They are demo keys — deterministic and public. Never reuse them.
