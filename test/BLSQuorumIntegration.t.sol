                3304877456389278212911144062620124687525125721989181796243368116323056933776
            ]
        });
    }

    function pkG2_1() internal pure returns (BN254Lib.G2Point memory) {
        return BN254Lib.G2Point({
            X: [
                uint256(6925250543173333900918339604601365821001698015008601407643477466524441393506),
                6013106775456218963000217368193289349832165727925450983529809427298369235782
            ],
