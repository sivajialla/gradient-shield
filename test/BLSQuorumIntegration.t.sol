/// @title BLS Quorum Integration
/// @notice End-to-end AVS loop with REAL BN254 BLS aggregate signatures:
///
///   sandwich on-chain → hook auto-creates task → operators sign in G1 →
///   aggregator submits → pairing precompile verifies → oracle score written →
///   next swap prices off the new score → repeat offender rejected.
///
/// No mocks, no overridden verification: every signature in this file is a real
/// BLS signature checked by the EVM's pairing precompile.
///
/// Keys generated by `node operator/blsKeygen.js --solidity`.
contract BLSQuorumIntegrationTest is Test, Deployers {
    using PoolIdLibrary for PoolKey;
    using BN254Lib for BN254Lib.G1Point;

    GradientShieldHook internal hook;
    ScoringOracle internal oracle;
    BLSQuorumTaskManager internal tm;

    PoolSwapTest internal botRouter;
    PoolSwapTest internal victimRouter;

    address internal aggregator = address(0xA66);
    address internal generator = address(0x6E11);

    address internal bot = address(0xB07);
    address internal victim = address(0xA01);

    address[3] internal operators = [address(0x09E1), address(0x09E2), address(0x09E3)];

    // ---- BLS keys: generated by operator/blsKeygen.js --solidity ----

    uint256 internal constant SK0 =
        11836524677592296387016191132851638603374790022583809656474156559297518898960;
    uint256 internal constant SK1 =
        19555997293406794063693177147922824186012332787252529891418736435524183332599;
    uint256 internal constant SK2 =
        5387227035703601869654588749405678853951065557445841164820569872053046802407;

    function pkG2_0() internal pure returns (BN254Lib.G2Point memory) {
        return BN254Lib.G2Point({
