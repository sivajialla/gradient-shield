    }

    function pkG2_2() internal pure returns (BN254Lib.G2Point memory) {
        return BN254Lib.G2Point({
            X: [
                uint256(10232681038361472899206715458036792605758577938341181091810178331886553019652),
                18650162000802332061573029776033305850753403025274315343574234725455186114229
            ],
            Y: [
                uint256(16519535467380043117273924777006933058286580987918465947027655130114061783960),
                15733189498907505314869522439888592490841021188326098235011183020971275858591
            ]
        });
    }

    /// Aggregate G2 key for signers {0,1,2}. G2 addition has no EVM precompile,
    /// so aggregates are precomputed off-chain — exactly as a real aggregator does.
    function apkG2_All3() internal pure returns (BN254Lib.G2Point memory) {
        return BN254Lib.G2Point({
            X: [
                uint256(2840644583317869262398633998794092728062714745195347789655693215124596099039),
                7613008426637789760294252186863964027461017681846194833368190508380176611534
            ],
