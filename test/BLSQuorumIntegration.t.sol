                uint256(11010470600951199211697531281820826206738753393686408421563789003927424186505),
                10444254178227287990843911155892801628184356026023855419141095646764940859503
            ]
        });
    }

    /// Aggregate G2 key for signers {0,1}.
    function apkG2_First2() internal pure returns (BN254Lib.G2Point memory) {
        return BN254Lib.G2Point({
            X: [
                uint256(17893237007145536954592889806467571901553555199057167520398058204904369149060),
                12297885063595889541228452148764789829336205176048302706525201359983951754985
            ],
            Y: [
                uint256(21818202474519982310384319866503611347553559630467044904841892990149710819067),
                1164509888561843959507299365287774311612264800489582549049509038088097948451
